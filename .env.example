# Anonymous action counts (optional). Copy to .env and fill in to turn them on.
# Leave both unset and the site sends nothing at all.
#
# VITE_EVENTS_URL takes an Umami-compatible /api/send endpoint. Prefer a path on this
# site (like /api/send) that the host forwards to Umami: the Content Security Policy
# only allows same-origin requests, and the forwarder can drop visitors' IP addresses.
VITE_EVENTS_URL=
VITE_EVENTS_SITE_ID=
