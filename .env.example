# Server settings for `pnpm start`. Copy to .env and fill in.

PORT=8080

# Anonymous counts. The server forwards them to Umami through
# @activistchecklist/umami-extra-privacy only when these are set; otherwise it
# accepts them and drops them.
#
# Self-hosted Umami:
UMAMI_WEBSITE_ID=
UMAMI_API_CLIENT_ENDPOINT=
UMAMI_API_CLIENT_USER_ID=
UMAMI_API_CLIENT_SECRET=
#
# Or Umami Cloud (takes precedence when set):
# UMAMI_API_KEY=
